# board_select.py cyd_s028r
# from jef-sure/boards 0.0.5, commit 2857470: board_select.py --again PROJECT_DIR makes it again when the component changes
# The board of this project, chosen by tools/board_select.py of jef-sure/boards: cyd_s028r
# Read before the project's own sdkconfig.defaults. Made from the data of the component: do not edit,
# run board_select.py again to change the board.
# The CYD (ESP32-2432S028R): what its chip and its flash need, read before the program's own
# defaults (SDKCONFIG_DEFAULTS of the project, tools/board_select.py puts this file there).
# The first two lines are the choice of the board: the chip, and the board in the menu of
# the configuration. The DGX drivers its panel needs (SPI, ILI9341) come with that choice.
CONFIG_IDF_TARGET="esp32"
CONFIG_BOARD_SELECT_CYD_S028R=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
