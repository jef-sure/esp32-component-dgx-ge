# The JC1060P470 with an ESP32-P4 below revision 3 (mine, 1.3), after sdkconfig.defaults: an ESP-IDF that knows
# revision 3 builds for 3.1 and later by default, which does not start on it. Its PSRAM goes at 200 MHz at most.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_SPIRAM_SPEED_200M=y
